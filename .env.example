# Set to "true" to serve the Works list from the in-app stub (no backend needed).
# Set to "false" to call the real backend via the API base URL below.
VITE_USE_STUB=true

# Base URL for API calls. Defaults to "/api", which the Vite dev server proxies
# to http://localhost:8080 (see vite.config.ts).
VITE_API_BASE_URL=/api
